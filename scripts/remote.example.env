# Copy this file to .remote-run.env in the repository root and adjust the values.

STG_REMOTE_HOST="user@your-server"
STG_REMOTE_REPO_DIR="/absolute/path/to/SpatialTemporalGraph"
STG_REMOTE_PROJECT="urban-traffic-benchmark"
STG_REMOTE_CONDA_ENV="graph_ml"
STG_REMOTE_MODE="bg"

# Optional. Leave unset to use the default remote log directory:
# $HOME/.spatial-temporal-graph-runs
# STG_REMOTE_LOGS_DIR="/absolute/path/to/remote/logs"
